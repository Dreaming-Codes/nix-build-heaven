diff --git a/meson.build b/meson.build
index 6060716..f18771a 100644
--- a/meson.build
+++ b/meson.build
@@ -71,11 +71,18 @@ has_add_temp_roots = cxx.compiles('''
 void f(nix::Store & s) { s.addTempRoots({}); }
 ''', dependencies : [nix_store_dep, nix_util_dep], name : 'Store::addTempRoots')
 
+# Determinate Nix adds a skipIfSlow flag to the virtual.
+add_temp_roots_skip_if_slow = cxx.compiles('''
+#include <nix/store/store-api.hh>
+struct S : nix::Store { void addTempRoots(const nix::StorePathSet &, bool) override; };
+''', dependencies : [nix_store_dep, nix_util_dep], name : 'Store::addTempRoots(paths, skipIfSlow)')
+
 # Version macros for src/nix-compat.hh.
 nix_compat_args = [
   '-DNIX_COMPAT_VERSION_MAJOR=' + nix_ver[0],
   '-DNIX_COMPAT_VERSION_MINOR=' + nix_ver_minor,
   '-DNIX_COMPAT_HAS_ADD_TEMP_ROOTS=' + (has_add_temp_roots ? '1' : '0'),
+  '-DNIX_COMPAT_ADD_TEMP_ROOTS_SKIP_IF_SLOW=' + (add_temp_roots_skip_if_slow ? '1' : '0'),
 ]
 
 # --- protobuf / gRPC codegen -----------------------------------------------
diff --git a/src/client/store.hh b/src/client/store.hh
index 04fdeb9..e2adaba 100644
--- a/src/client/store.hh
+++ b/src/client/store.hh
@@ -698,7 +698,9 @@ public:
     // copyPaths() roots on the destination since NixOS/nix#16113 (same
     // 2.36pre as substituter.hh). RemoteStore would open the daemon socket
     // for it, which the write role may not. The server roots what it gets.
-#if NIX_COMPAT_HAS_ADD_TEMP_ROOTS
+#if NIX_COMPAT_ADD_TEMP_ROOTS_SKIP_IF_SLOW
+    void addTempRoots(const StorePathSet & /*paths*/, bool /*skipIfSlow*/) override {}
+#elif NIX_COMPAT_HAS_ADD_TEMP_ROOTS
     void addTempRoots(const StorePathSet & /*paths*/) override {}
 #elif __has_include(<nix/store/substituter.hh>)
     void addTempRoot(const StorePath & /*path*/) override {}
